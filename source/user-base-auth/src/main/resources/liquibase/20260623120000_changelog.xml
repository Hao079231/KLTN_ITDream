        <addColumn tableName="db_it_dream_simulation_enrollment">
            <column name="review_status" type="INT" defaultValueNumeric="0">
                <constraints nullable="false"/>
            </column>
        </addColumn>
    </changeSet>

</databaseChangeLog>
